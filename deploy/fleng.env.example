# Template for /etc/fleng/fleng.env on the VPS (root:fleng, mode 0640).
# Never commit the real file. Replace every <...> on the server only.
APP_ENV=production
PORT=3001
# Loopback only: nginx is the single public entry point.
HOST=127.0.0.1
# Generate the password on the server: openssl rand -hex 24 (hex needs no URL encoding).
DATABASE_URL=postgresql://fleng:<DB_PASSWORD>@127.0.0.1:5432/fleng
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_ACCESS_SECRET=<RANDOM_SECRET_MIN_32_CHARS>
# Exact HTTPS origins, no trailing slash. <HOSTNAME> is e.g. 203-0-113-7.sslip.io
CORS_ORIGIN=https://fleng.netlify.app,https://<HOSTNAME>
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# nginx on the same host. Client-IP rate limits behind the Netlify proxy are verified separately.
TRUSTED_PROXY_IPS=127.0.0.1
LEARNING_TIMEZONE=UTC
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
RESET_DELIVERY=disabled
