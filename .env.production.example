# Reference for hosting environment variables. Inject secrets through the host.
APP_ENV=production
PORT=3001
# Recommended for durable storage:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fleng
# Free Render SQLite alternative (ephemeral; data can be lost):
# DATABASE_URL=sqlite+aiosqlite:///./data/fleng.db
JWT_ACCESS_SECRET=change-me-generate-a-unique-random-secret
CORS_ORIGIN=https://YOUR_APP_DOMAIN
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Empty disables proxy-header trust. Set only the known ingress IPs/networks.
TRUSTED_PROXY_IPS=
LEARNING_TIMEZONE=UTC
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_MAX_INPUT_TOKENS=24000
RESET_DELIVERY=disabled
