# Reference for hosting environment variables. Inject secrets through the host.
APP_ENV=production
PORT=3001
# Unset = 127.0.0.1 (0.0.0.0 on Render via RENDER_EXTERNAL_URL). VPS template: deploy/fleng.env.example
# Recommended for durable storage:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fleng?sslmode=verify-full
# Render Free requires external PostgreSQL; ephemeral SQLite is rejected.
# Paid SQLite alternative ONLY with a real persistent disk mounted at /var/data:
# DATABASE_URL=sqlite+aiosqlite:////var/data/fleng.db
JWT_ACCESS_SECRET=change-me-generate-a-unique-random-secret
# Both public entry points must be explicit: Render terminates HTTPS upstream.
CORS_ORIGIN=https://fleng-fly.onrender.com,https://fleng.netlify.app
# Render automatically supplies RENDER_EXTERNAL_URL; its exact HTTPS origin is
# also allowed by Settings, independently of upstream HTTP / proxy-header trust.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Empty disables proxy-header trust. Set only the known ingress IPs/networks.
TRUSTED_PROXY_IPS=
LEARNING_TIMEZONE=UTC
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Required together with the three lines above: without both prices Fleng AI stays
# "Unavailable" because spend cannot be bounded (USD per million tokens, from the model page).
# Uncomment and fill in (an empty value is rejected at startup):
# AI_INPUT_PRICE_PER_MTOK_USD=
# AI_OUTPUT_PRICE_PER_MTOK_USD=
AI_DAILY_BUDGET_USD=1.00
AI_MAX_INPUT_TOKENS=24000
RESET_DELIVERY=disabled

# Optional Google sign-in (all three required; see docs/authentication.md).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain/api/v1/auth/google/callback
