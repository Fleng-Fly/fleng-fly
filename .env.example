# Fleng — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# This file intentionally contains only safe placeholders.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Backend ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (matches docker compose service by default)
DATABASE_URL=postgresql://fleng:fleng@localhost:5432/fleng?schema=public

# Auth secrets — generate distinct, long random values in real environments.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Allowed frontend origin(s) for CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000

# ── AI (server-side only) ───────────────────────────────────────────────────
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=30000

# ── Frontend (public) ───────────────────────────────────────────────────────
# Only NEXT_PUBLIC_* values reach the browser. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
