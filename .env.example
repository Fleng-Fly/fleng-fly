# Fleng — environment template
# Copy to `.env` in the repository root and fill in real values.
# NEVER commit `.env`. This file contains only safe placeholders.

# ── Backend runtime ────────────────────────────────────────────────────────
APP_ENV=development
PORT=3001

# ── Database ───────────────────────────────────────────────────────────────
# Local default; relative SQLite paths always resolve against backend/.
DATABASE_URL=sqlite+aiosqlite:///./data/fleng.db
# PostgreSQL remains available (plain URLs select asyncpg automatically):
# DATABASE_URL=postgresql://fleng:fleng@localhost:5432/fleng

# ── CORS ───────────────────────────────────────────────────────────────────
# Extra allowed origins, comma-separated. The app's own origin (which serves
# the static frontend) is always trusted, so this is only needed for other
# frontends/clients.
CORS_ORIGIN=http://localhost:3000

# ── Authentication ─────────────────────────────────────────────────────────
# Required in production (startup fails otherwise). Development has a
# deliberately insecure default; every environment should set a real secret.
JWT_ACCESS_SECRET=change-me-to-a-long-random-value

# ── Frontend (served by the backend) ───────────────────────────────────────
# The static frontend is served from the backend's own origin and calls the
# relative /api/v1, so it needs no environment configuration. Optionally
# override the directory that is served (defaults to the repository frontend/).
# FRONTEND_DIR=

# Learning extensions
LEARNING_TIMEZONE=UTC
HTTP_MAX_BODY_BYTES=131072
# Password reset is disabled by default. Use a local SMTP inbox in development.
RESET_DELIVERY=disabled
RESET_TOKEN_MINUTES=30
RESET_RATE_PER_HOUR=5
RESET_URL=http://localhost:3001/reset-password.html
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true

# Server-only OpenRouter configuration (disabled until explicitly configured)
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
AI_STRUCTURED_OUTPUTS=false
AI_MAX_OUTPUT_TOKENS=800
AI_REQUEST_TIMEOUT=30
AI_MAX_INPUT_CHARS=4000
AI_MAX_RESPONSE_CHARS=16000
AI_HISTORY_MESSAGES=20
AI_HISTORY_CHARS=16000
AI_MESSAGES_PER_CONVERSATION=200
AI_CONVERSATIONS_PER_USER=50
AI_REQUESTS_PER_MINUTE=10
AI_DAILY_REQUESTS=100
AI_DAILY_TOKEN_BUDGET=100000
AI_CONCURRENCY=4
