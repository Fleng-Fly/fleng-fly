# Fleng — environment template
# Copy to `.env` in the repository root and fill in real values.
# NEVER commit `.env`. This file contains only safe placeholders.

# ── Backend runtime ────────────────────────────────────────────────────────
APP_ENV=development
PORT=3001

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Plain postgresql:// is accepted; the backend adds the asyncpg driver.
# Matches the docker-compose `db` service below.
DATABASE_URL=postgresql://fleng:fleng@localhost:5432/fleng

# ── CORS ───────────────────────────────────────────────────────────────────
# Extra allowed origins, comma-separated. The app's own origin (which serves
# the static frontend) is always trusted, so this is only needed for other
# frontends/clients.
CORS_ORIGIN=http://localhost:3000

# ── Authentication ─────────────────────────────────────────────────────────
# Required in production (startup fails otherwise). Development has a
# deliberately insecure default; every environment should set a real secret.
JWT_ACCESS_SECRET=change-me-to-a-long-random-value

# ── Frontend (served by the backend) ───────────────────────────────────────
# The static frontend is served from the backend's own origin and calls the
# relative /api/v1, so it needs no environment configuration. Optionally
# override the directory that is served (defaults to the repository frontend/).
# FRONTEND_DIR=
