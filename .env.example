# Fleng — environment template
# Copy to `.env` in the repository root and fill in real values.
# NEVER commit `.env`. This file contains only safe placeholders.

# ── Backend runtime ────────────────────────────────────────────────────────
APP_ENV=development
PORT=3001

# ── Database ───────────────────────────────────────────────────────────────
# Local default; relative SQLite paths always resolve against backend/.
DATABASE_URL=sqlite+aiosqlite:///./data/fleng.db
# PostgreSQL remains available (plain URLs select asyncpg automatically):
# DATABASE_URL=postgresql://fleng:fleng@localhost:5432/fleng

# ── CORS ───────────────────────────────────────────────────────────────────
# Extra allowed origins, comma-separated. The app's own origin (which serves
# the static frontend) is always trusted, so this is only needed for other
# frontends/clients.
CORS_ORIGIN=http://localhost:3000

# ── Authentication ─────────────────────────────────────────────────────────
# Required in production (startup fails otherwise). Development has a
# deliberately insecure default; every environment should set a real secret.
JWT_ACCESS_SECRET=change-me-to-a-long-random-value

# ── Frontend (served by the backend) ───────────────────────────────────────
# The static frontend is served from the backend's own origin and calls the
# relative /api/v1, so it needs no environment configuration. Optionally
# override the directory that is served (defaults to the repository frontend/).
# FRONTEND_DIR=

# Learning extensions
LEARNING_TIMEZONE=UTC
HTTP_MAX_BODY_BYTES=131072
# Password reset is disabled by default. Use a local SMTP inbox in development.
RESET_DELIVERY=disabled
RESET_TOKEN_MINUTES=30
RESET_RATE_PER_HOUR=5
RESET_URL=http://localhost:3001/reset-password.html
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true

# Server-only OpenRouter configuration (disabled until explicitly configured)
# Floating Dashboard/Lessons assistant uses these existing settings.
# Missing configuration keeps the app running and the assistant unavailable.
# Set AI_ENABLED=true, a backend-only key and a valid provider/model ID to enable.
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
AI_STRUCTURED_OUTPUTS=false
AI_MAX_OUTPUT_TOKENS=800
# Per-learner UTC-day message quota, message length, concurrent requests per learner.
AI_DAILY_USER_LIMIT=30
AI_MAX_MESSAGE_LENGTH=500
AI_MAX_CONCURRENT_REQUESTS=1
# DEPRECATED, now ignored (rename): AI_MAX_INPUT_CHARS -> AI_MAX_MESSAGE_LENGTH (500),
# AI_DAILY_REQUESTS -> AI_DAILY_USER_LIMIT (30). Old values do not take effect.
# Global OpenRouter spend per UTC day, shared by all workers through the database.
AI_DAILY_BUDGET_USD=1.00
# REQUIRED to enable AI: the fixed model's OpenRouter tariff, USD per million tokens.
# Unset prices keep AI unavailable (cost cannot be bounded). openrouter/* routers and
# :online models are refused. Copy the prices from the model page on openrouter.ai.
AI_INPUT_PRICE_PER_MTOK_USD=
AI_OUTPUT_PRICE_PER_MTOK_USD=
# Conservative UTF-8 byte/token upper bound for the assembled prompt.
AI_MAX_INPUT_TOKENS=24000
AI_REQUEST_TIMEOUT=30
AI_MAX_RESPONSE_CHARS=16000
AI_HISTORY_MESSAGES=20
AI_HISTORY_CHARS=16000
AI_MESSAGES_PER_CONVERSATION=200
AI_CONVERSATIONS_PER_USER=50
AI_REQUESTS_PER_MINUTE=10
# Per-learner worst-case token reservations per UTC day (30 x 24800 by default).
AI_DAILY_TOKEN_BUDGET=750000
AI_CONCURRENCY=4

# Persistent authentication fixed-window quotas (attempts, success or failure)
AUTH_LOGIN_IP_PER_MINUTE=20
AUTH_LOGIN_EMAIL_PER_MINUTE=10
AUTH_REGISTER_IP_PER_HOUR=10

# Production defaults to Secure cookies; never disable for HTTPS hosting.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Production launcher only: trust the known ingress IPs/networks, never arbitrary clients.
TRUSTED_PROXY_IPS=

# Public HTTPS Settings URL for email-change confirmation links
EMAIL_CHANGE_URL=http://localhost:3001/settings.html

# Google sign-in (optional; all three required). Callback must also be registered in
# Google Cloud Console. See docs/authentication.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Seconds a rotated refresh token may be retried if its response was lost (0 = strict).
# REFRESH_REUSE_GRACE_SECONDS=10
