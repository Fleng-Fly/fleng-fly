# Fleng — environment template
# Copy to `.env` in the repository root and fill in real values.
# NEVER commit `.env`. This file contains only safe placeholders.

# ── Backend runtime ────────────────────────────────────────────────────────
APP_ENV=development
PORT=3001

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Plain postgresql:// is accepted; the backend adds the asyncpg driver.
# Matches the docker-compose `db` service below.
DATABASE_URL=postgresql://fleng:fleng@localhost:5432/fleng

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# ── Development-only identity ──────────────────────────────────────────────
# Used by the temporary dev auth dependency (never active when APP_ENV=production).
# Authentication is NOT implemented yet; see docs/backend.md.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ── Frontend (public) ──────────────────────────────────────────────────────
# Only NEXT_PUBLIC_* values reach the browser. Next.js reads env from
# frontend/.env.local (git-ignored); the app defaults to the URL below.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
