{
  "name": "fleng",
  "version": "0.1.0",
  "private": true,
  "description": "Fleng — a web platform for learning English.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "pnpm backend:lint",
    "typecheck": "pnpm backend:typecheck",
    "test": "pnpm backend:test",
    "format": "prettier --write . && pnpm backend:format",
    "format:check": "prettier --check .",
    "backend:dev": "cd backend && .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port ${PORT:-3001}",
    "backend:lint": "cd backend && .venv/bin/ruff check app tests",
    "backend:format": "cd backend && .venv/bin/ruff format app tests",
    "backend:typecheck": "cd backend && .venv/bin/mypy app",
    "backend:test": "cd backend && .venv/bin/pytest",
    "db:migrate": "cd backend && .venv/bin/alembic upgrade head",
    "db:prepare": "cd backend && .venv/bin/python -m app.db.prepare",
    "db:sql": "cd backend && .venv/bin/alembic upgrade head --sql",
    "db:seed": "cd backend && .venv/bin/python -m app.db.seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
