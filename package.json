{
  "name": "fleng",
  "version": "0.1.0",
  "private": true,
  "description": "Fleng — a web platform for learning English.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "lint": "pnpm backend:lint",
    "typecheck": "pnpm backend:typecheck",
    "test": "pnpm backend:test",
    "format": "prettier --write . && pnpm backend:format",
    "format:check": "prettier --check .",
    "backend:dev": "node scripts/dev.mjs",
    "backend:lint": "node scripts/backend.mjs ruff check app tests",
    "backend:format": "node scripts/backend.mjs ruff format app tests",
    "backend:typecheck": "node scripts/backend.mjs mypy app",
    "backend:test": "node scripts/backend.mjs pytest",
    "db:migrate": "node scripts/backend.mjs alembic upgrade head",
    "db:prepare": "node scripts/backend.mjs app.db.prepare",
    "db:sql": "node scripts/backend.mjs alembic upgrade head --sql",
    "db:seed": "node scripts/backend.mjs app.db.seed",
    "demo:prepare": "node scripts/backend.mjs app.db.prepare && node scripts/backend.mjs app.db.demo",
    "test:pwa": "node scripts/test-pwa.mjs && node scripts/test-pwa-install.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
