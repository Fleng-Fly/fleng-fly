{
  "name": "fleng",
  "version": "0.1.0",
  "private": true,
  "description": "Fleng — a web platform for learning English.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "lint": "pnpm backend:lint",
    "typecheck": "pnpm backend:typecheck",
    "test": "pnpm backend:test",
    "format": "prettier --write . && pnpm backend:format",
    "format:check": "prettier --check .",
    "backend:dev": "cd backend && .venv/bin/uvicorn app.main:app --reload --no-proxy-headers --host 0.0.0.0 --port ${PORT:-3001}",
    "backend:lint": "cd backend && .venv/bin/ruff check app tests",
    "backend:format": "cd backend && .venv/bin/ruff format app tests",
    "backend:typecheck": "cd backend && .venv/bin/mypy app",
    "backend:test": "cd backend && .venv/bin/pytest",
    "db:migrate": "cd backend && .venv/bin/alembic upgrade head",
    "db:prepare": "cd backend && .venv/bin/python -m app.db.prepare",
    "db:sql": "cd backend && .venv/bin/alembic upgrade head --sql",
    "db:seed": "cd backend && .venv/bin/python -m app.db.seed",
    "demo:prepare": "cd backend && .venv/bin/python -m app.db.prepare && .venv/bin/python -m app.db.demo",
    "db:verify": "cd backend && .venv/bin/pytest -q tests/test_database_pipeline.py tests/test_postgres_migrations.py",
    "db:backup": "cd backend && .venv/bin/python -m app.db.backup",
    "curriculum:validate": "cd backend && .venv/bin/python -m app.db.curriculum --validate-only",
    "curriculum:import-drafts": "cd backend && .venv/bin/python -m app.db.curriculum --apply-draft",
    "curriculum:preview:prepare": "backend/.venv/bin/python scripts/preview_curriculum.py prepare",
    "curriculum:preview": "backend/.venv/bin/python scripts/preview_curriculum.py start",
    "frontend:test": "node --experimental-vm-modules --test scripts/test-courses.mjs scripts/test-ai-api.mjs scripts/test-ai-stream.mjs scripts/test-ai-widget.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
